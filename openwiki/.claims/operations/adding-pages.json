      "id": "claim_50d5f754af2648b1a22070a9b6535576",
      "statement": "The LangChain documentation operates three content branches: (1) OSS versioned content (LangChain, LangGraph, most Deep Agents) builds to separate /oss/python/... and /oss/javascript/... URLs; (2) OSS language-agnostic content (/src/oss/openwiki/ and /src/oss/deepagents/code/) builds to single unversioned URLs; (3) LangSmith unversioned content (/src/langsmith/) builds to /langsmith/... URLs, except Managed Deep Agents which branch into language routes.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/builder.py#L75-L136",
          "version": "repo-lines-v1:sha256:949e4203139c8a0525ca36ea161a9e5ecc45b767ad72829f8d3d2624562a9d96:"
