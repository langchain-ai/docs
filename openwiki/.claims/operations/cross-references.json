        }
      ]
    },
    {
      "id": "claim_2659af93fd9647088fdbe286a3c43f0f",
      "statement": "The @[ClassName] syntax supports three formats: simple reference @[ClassName], custom title @[Custom Title][ClassName], and backtick-wrapped @[`ClassName`], with backticks automatically preserved in the rendered link title.",
