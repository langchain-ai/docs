    {
      "id": "claim_04eeafcb91864afeb77f7113f3b0d24c",
      "statement": "The cross-reference system uses @[ClassName] syntax in markdown to reference API documentation by semantic name rather than hardcoded URL, resolving to language-specific links based on the active scope (python or js) at build time.",
      "evidence": [
        {
          "resource": "repo://pipeline/preprocessors/handle_auto_links.py#L1-L20",
          "version": "repo-lines-v1:sha256:dec39499f631a395060a0bdec1efb92e5d35cbc3a28a74a4ae06c961f348bf64:"
