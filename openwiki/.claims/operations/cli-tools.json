    {
      "id": "claim_6644bd73a0cc460685ec7b13f96b2b44",
      "statement": "The `docs` Python CLI is registered as a project script entry point at `pipeline.cli:main` in `pyproject.toml`, making it available as `uv run pipeline <command>` or (after installation) as `docs <command>`.",
      "evidence": [
        {
          "resource": "repo://pipeline/cli.py#L231-L246",
          "version": "repo-lines-v1:sha256:0ed3778ddcb7c00e56acea23b04e7ab2b050d82f808657e2934150c0e320a20b:"
        },
        {
