        }
      ]
    },
    {
      "id": "claim_d5dc24592ae44ebd809543bd6baeee6f",
      "statement": "`docs build` reads documentation from `src/`, validates the directory exists, creates the `/build` directory if needed, and uses `DocumentationBuilder` to preprocess files and copy them to `/build`, returning exit code 0 on success or 1 on failure.",
