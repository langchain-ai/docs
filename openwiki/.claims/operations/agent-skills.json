    {
      "id": "claim_5e62afeb3622464589089d5bb2b2cc43",
      "statement": "The integration-submission workflow runs only on manual dispatch or an `integration-run` label event, authorizes the triggering actor as a maintainer or collaborator with write access, parses the issue form into JSON, passes it as untrusted metadata to the `submit-integration` skill, and opens a pull request only after the agent leaves real working-tree changes.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/integration-submission.yml",
          "version": "repo-file-v1:sha256:1b3e15d4d5d2e12662aec62a43ba2d85f6d35258c8a61822b24e1fb1094f2e5f"
        }
      ]
    },
    {
      "id": "claim_95af98c74fef42ceacba72db533890c8",
      "statement": "The integration-submission workflow prevents duplicate automated processing by skipping issues already labelled `integration-automation`; it handles a blocker file, unsuccessful agent result, or empty diff by commenting the outcome and not creating a pull request.",
      "evidence": [
