        }
      ]
    },
    {
      "id": "claim_882b4dbf735148d493ca5aff304aa33e",
      "statement": "Layer 3 (UTM Link Decoration) tags conversion-oriented links to smith.langchain.com (CTA paths: '', '/', '/agents', '/agents/') with utm_source=docs, utm_medium=cta, utm_campaign=langsmith-signup, and utm_content derived from file path. Functional links (settings, hub, traces) and content in code blocks are skipped. Existing query parameters are preserved.",
