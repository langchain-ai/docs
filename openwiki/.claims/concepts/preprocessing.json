    {
      "id": "claim_39d16b04ebe7470596ddea3aaf2ce833",
      "statement": "Layer 1 (Conditional Rendering) processes :::language blocks to retain content matching the target language and remove non-matching blocks; escaped blocks (\\:::) are preserved as literal text and unescaped in the output. Unsupported language specifiers are left unchanged and ValueError is raised if target_language is invalid.",
      "evidence": [
        {
          "resource": "repo://pipeline/preprocessors/markdown_preprocessor.py#L19-L72",
          "version": "repo-lines-v1:sha256:8b7c4c0b8e2d3c608073651239724ba37d8a1fa1955b46e6fd68d74e9020910e:"
        }
      ]
    },
    {
      "id": "claim_28366c6af1074f63b641fc8489c92b31",
      "statement": "Layer 2 (Cross-Reference Resolution) transforms @[link_name] and @[title][link_name] patterns into markdown links by looking up link_name in scope-specific SCOPE_LINK_MAPS. Scope is set by conditional fences or defaults to default_scope; scope changes inside code fences do not affect processing. Unresolved links are logged as info warnings and left unchanged.",
      "evidence": [
        {
          "resource": "repo://pipeline/preprocessors/handle_auto_links.py#L156-L226",
          "version": "repo-lines-v1:sha256:eacf3a1a4073c2d76f129a197ca1d25862ebcbae9b143282f63c05f4ecb47446:"
