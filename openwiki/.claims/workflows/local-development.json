        }
      ]
    },
    {
      "id": "claim_f14b8317a53d4396b8594d6cff07c558",
      "statement": "The development mode performs an initial build of all documentation unless `--skip-build` is set. The build validates the entire documentation structure and generates version-specific output in `/build` before watching begins.",
      "evidence": [
        {
          "resource": "repo://pipeline/commands/dev.py#L70-L90",
