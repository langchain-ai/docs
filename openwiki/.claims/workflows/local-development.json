        }
      ]
    },
    {
      "id": "claim_dcbdca1cab614267a8aa2a10736b33a9",
      "statement": "`make dev` (or `uv run pipeline dev`) orchestrates development by performing an initial build, starting a file watcher on `/src`, launching Mintlify dev server on localhost:3000, and managing cleanup on interrupt.",
