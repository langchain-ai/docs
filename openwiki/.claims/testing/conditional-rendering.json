    {
      "id": "claim_b5609060ab754e108cdd6688a7b441bc",
      "statement": "The _apply_conditional_rendering() function in /pipeline/preprocessors/markdown_preprocessor.py resolves conditional blocks based on target_language: when target_language=\"python\", :::python blocks are kept and :::js blocks are removed; when target_language=\"js\", :::js blocks are kept and :::python blocks are removed.",
      "evidence": [
        {
          "resource": "repo://pipeline/preprocessors/markdown_preprocessor.py#L19-L72",
          "version": "repo-lines-v1:sha256:8b7c4c0b8e2d3c608073651239724ba37d8a1fa1955b46e6fd68d74e9020910e:"
        }
      ]
    },
    {
      "id": "claim_b04a2213282141c19f652bc4019baa84",
      "statement": "Escaped conditional markers (\\:::python and \\:::) are preserved as literal text during processing; the backslash is removed in post-processing via re.sub(r'\\\\(:::)', r'\\1', result), allowing documentation of the syntax itself.",
      "evidence": [
        {
          "resource": "repo://pipeline/preprocessors/markdown_preprocessor.py#L27-L30",
          "version": "repo-lines-v1:sha256:b1093ddf4fb5540f7843acdae4fe6357f1bdc0bdc17cc82d71b84e1d1492d083:"
