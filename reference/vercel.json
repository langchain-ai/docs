{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "public": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": ""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://docs.langchain.com"
    },
    {
      "source": "/python/versions/latest",
      "destination": "/python"
    }
  ]
}
